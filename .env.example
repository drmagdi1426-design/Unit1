# Copy this file to .env and fill in real values.

# PostgreSQL connection string used by the app at runtime (Supabase, Neon, or
# any Postgres instance). On serverless hosts (Vercel), use the POOLED
# connection string:
# Supabase: Project Settings -> Database -> Connection string -> URI -> "Transaction pooler" (port 6543, append ?pgbouncer=true).
# Neon: Project -> Connection Details -> "Pooled connection" (host has "-pooler" in it).
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?schema=public"

# DIRECT (non-pooled) connection string, used only for running migrations
# (`prisma migrate deploy`/`dev`). Pooled connections (PgBouncer transaction
# mode) don't support the advisory lock migrations take, and fail with P1002
# ("timed out trying to acquire a postgres advisory lock"). Same host as
# DATABASE_URL but WITHOUT "-pooler"/without the pgbouncer port. If you're on
# a single non-pooled Postgres instance (e.g. local dev), just omit this —
# it falls back to DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Random long secret used to sign admin session cookies (JWT). Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32+-character-secret"

# Admin login has no username/account — anyone who enters this exact code at
# /admin/login gets admin access. Not stored in the database, read straight
# from this env var, so rotating it is just: change this value, redeploy.
ADMIN_ACCESS_CODE="change-me-to-a-hard-to-guess-code"
